<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.opc</groupId>
        <artifactId>opc</artifactId>
        <version>3.9.2</version>
    </parent>

    <artifactId>opc-coverage</artifactId>
    <packaging>pom</packaging>

    <dependencies>
        <dependency>
            <groupId>com.opc</groupId>
            <artifactId>opc-admin</artifactId>
            <version>${opc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.opc</groupId>
            <artifactId>opc-framework</artifactId>
            <version>${opc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.opc</groupId>
            <artifactId>opc-system</artifactId>
            <version>${opc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.opc</groupId>
            <artifactId>opc-quartz</artifactId>
            <version>${opc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.opc</groupId>
            <artifactId>opc-generator</artifactId>
            <version>${opc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.opc</groupId>
            <artifactId>opc-common</artifactId>
            <version>${opc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
